# Copy to agent/.env.local (gitignored) and fill in. Never commit real values.

# LiveKit Cloud project -> Settings -> API Keys
LIVEKIT_URL=wss://<your-project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Google AI Studio key with Gemini Live access (server-side only)
GOOGLE_API_KEY=

# Optional overrides (defaults live in src/config.ts)
# NAFY_MODE=hello            # Phase 5 hello-world: fixed greeting, no tools
# NAFY_VOICE=Aoede           # Aoede | Kore | Charon | Puck | Fenrir | ...
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_LIVE_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/azan-buddy/google-ai-studio
