# Copy to .env (gitignored). Values are read by Metro at bundle time.

# Checkpoint 2: Gemini text coaching via Cloudflare AI Gateway
EXPO_PUBLIC_GEMINI_API_KEY=

# Checkpoint 3: LiveKit Cloud sandbox token server ID (dashboard -> Sandbox -> Token server).
# Development only: anyone with this ID can mint room tokens for the project.
EXPO_PUBLIC_LIVEKIT_SANDBOX_ID=
